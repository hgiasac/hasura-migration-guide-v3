        enableAll: true
    - fieldName: FirstName
      orderByDirections:
        enableAll: true
    - fieldName: HireDate
      orderByDirections:
        enableAll: true
    - fieldName: LastName
      orderByDirections:
        enableAll: true
    - fieldName: Phone
      orderByDirections:
        enableAll: true
    - fieldName: PostalCode
      orderByDirections:
        enableAll: true
    - fieldName: ReportsTo
      orderByDirections:
        enableAll: true
    - fieldName: State
      orderByDirections:
        enableAll: true
    - fieldName: Title
      orderByDirections:
        enableAll: true
  graphql:
    selectMany:
      queryRootField: Employee
      subscription:
        rootField: Employee
    selectUniques:
      - queryRootField: Employee_by_EmployeeId
        uniqueIdentifier:
          - EmployeeId
        subscription:
          rootField: Employee_by_EmployeeId
    orderByExpressionType: chinook_Employee_order_by
    filterInputTypeName: chinook_Employee_filter_input
    aggregate:
      queryRootField: Employee_aggregate
      subscription:
        rootField: Employee_aggregate
  aggregateExpression: Employee_agg_exp

---
kind: ModelPermissions
version: v1
definition:
  modelName: Employee
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

