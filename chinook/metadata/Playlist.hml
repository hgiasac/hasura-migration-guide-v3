---
kind: ObjectType
version: v1
definition:
  name: Playlist
  fields:
    - name: Name
      type: varchar
    - name: PlaylistId
      type: int4!
  graphql:
    typeName: chinook_Playlist
    inputTypeName: chinook_Playlist_input
  dataConnectorTypeMapping:
    - dataConnectorName: chinook
      dataConnectorObjectType: Playlist

---
kind: TypePermissions
version: v1
definition:
  typeName: Playlist
  permissions:
    - role: admin
      output:
        allowedFields:
          - Name
          - PlaylistId

---
kind: Model
version: v1
definition:
  name: Playlist
  objectType: Playlist
  source:
    dataConnectorName: chinook
    collection: Playlist
  filterExpressionType: Playlist_bool_exp
  orderableFields:
    - fieldName: Name
      orderByDirections:
        enableAll: true
    - fieldName: PlaylistId
      orderByDirections:
        enableAll: true
  graphql:
    selectMany:
      queryRootField: Playlist
      subscription:
        rootField: Playlist
    selectUniques:
      - queryRootField: Playlist_by_PlaylistId
        uniqueIdentifier:
          - PlaylistId
        subscription:
          rootField: Playlist_by_PlaylistId
    orderByExpressionType: chinook_Playlist_order_by
    filterInputTypeName: chinook_Playlist_filter_input
    aggregate:
      queryRootField: Playlist_aggregate
      subscription:
        rootField: Playlist_aggregate
  aggregateExpression: Playlist_agg_exp

---
kind: ModelPermissions
version: v1
definition:
  modelName: Playlist
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

---
kind: Relationship
version: v1
definition:
  name: PlaylistTracks
  sourceType: Playlist
  target:
    model:
      name: PlaylistTrack
      relationshipType: Array
  mapping:
    - source:
        fieldPath:
          - fieldName: PlaylistId
      target:
        modelField:
          - fieldName: PlaylistId

---
kind: BooleanExpressionType
version: v1
definition:
  name: Playlist_bool_exp
  operand:
    object:
      type: Playlist
      comparableFields:
        - fieldName: Name
          booleanExpressionType: varchar_bool_exp
        - fieldName: PlaylistId
          booleanExpressionType: int4_bool_exp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: chinook_Playlist_bool_exp

---
kind: AggregateExpression
version: v1
definition:
  name: Playlist_agg_exp
  operand:
    object:
      aggregatedType: Playlist
      aggregatableFields:
        - fieldName: Name
          aggregateExpression: varchar_agg_exp
        - fieldName: PlaylistId
          aggregateExpression: int4_agg_exp
  count:
    enable: true
  graphql:
    selectTypeName: chinook_Playlist_agg_exp

