---
kind: ObjectType
version: v1
definition:
  name: todo
  fields:
    - name: completed
      type: Boolean!
    - name: id
      type: int4!
    - name: task
      type: String!
    - name: user_id
      type: int4!
  graphql:
    typeName: todo
    inputTypeName: todo_input
  dataConnectorTypeMapping:
    - dataConnectorName: data
      dataConnectorObjectType: todo

---
kind: TypePermissions
version: v1
definition:
  typeName: todo
  permissions:
    - role: admin
      output:
        allowedFields:
          - completed
          - id
          - task
          - user_id

---
kind: Model
version: v1
definition:
  name: todo
  objectType: todo
  source:
    dataConnectorName: data
    collection: todo
  filterExpressionType: todo_bool_exp
  orderableFields:
    - fieldName: completed
      orderByDirections:
        enableAll: true
    - fieldName: id
      orderByDirections:
        enableAll: true
    - fieldName: task
      orderByDirections:
        enableAll: true
    - fieldName: user_id
      orderByDirections:
        enableAll: true
  graphql:
    selectMany:
      queryRootField: todo
      subscription:
        rootField: todo
    selectUniques:
      - queryRootField: todo_by_id
        uniqueIdentifier:
          - id
        subscription:
          rootField: todo_by_id
    orderByExpressionType: todo_order_by
    filterInputTypeName: todo_filter_input
    aggregate:
      queryRootField: todo_aggregate
      subscription:
        rootField: todo_aggregate
  aggregateExpression: todo_agg_exp

---
kind: ModelPermissions
version: v1
definition:
  modelName: todo
  permissions:
    - role: admin
      select:
        filter: null
        allowSubscriptions: true

---
kind: Relationship
version: v1
definition:
  name: user
  sourceType: todo
  target:
    model:
      name: users
      relationshipType: Object
  mapping:
    - source:
        fieldPath:
          - fieldName: user_id
      target:
        modelField:
          - fieldName: id

---
kind: BooleanExpressionType
version: v1
definition:
  name: todo_bool_exp
  operand:
    object:
      type: todo
      comparableFields:
        - fieldName: completed
          booleanExpressionType: bool_bool_exp
        - fieldName: id
          booleanExpressionType: int4_bool_exp
        - fieldName: task
          booleanExpressionType: text_bool_exp
        - fieldName: user_id
          booleanExpressionType: int4_bool_exp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: todo_bool_exp

---
kind: AggregateExpression
version: v1
definition:
  name: todo_agg_exp
  operand:
    object:
      aggregatedType: todo
      aggregatableFields:
        - fieldName: completed
          aggregateExpression: bool_agg_exp
        - fieldName: id
          aggregateExpression: int4_agg_exp
        - fieldName: task
          aggregateExpression: text_agg_exp
        - fieldName: user_id
          aggregateExpression: int4_agg_exp
  count:
    enable: true
  graphql:
    selectTypeName: todo_agg_exp

